{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magicbot-cf-computer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // One container class = the bot's cloud computer. Each bot maps to one
  // sandbox instance keyed by its botId (see src/index.ts). Bump max_instances
  // to the number of concurrent bot computers you want to allow.
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "standard",
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "Sandbox", "name": "Sandbox" }]
  },
  "migrations": [{ "new_sqlite_classes": ["Sandbox"], "tag": "v1" }],
  // Set with: wrangler secret put MAGICBOT_COMPUTER_TOKEN
  // The MagicBot harness sends this as a Bearer token on every request.
  "vars": {}
}
