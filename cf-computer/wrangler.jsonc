{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "magicbot-cf-computer",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  // One official Cloudflare Computer workspace + container per bot.
  "containers": [
    {
      "class_name": "Computer",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 10
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "Computer", "name": "Computer" }]
  },
  "migrations": [
    { "new_sqlite_classes": ["Sandbox"], "tag": "v1" },
    { "new_sqlite_classes": ["Computer"], "tag": "v2" }
  ],
  // Set with: wrangler secret put MAGICBOT_COMPUTER_TOKEN
  // The MagicBots harness sends this as a Bearer token on every request.
  "vars": {}
}
