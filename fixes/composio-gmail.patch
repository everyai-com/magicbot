+/** Gmail credentials stay with Composio; use the authenticated platform user ID. */
+export type ComposioGmailEnv = { COMPOSIO_API_KEY?: string };
+const base = "https://backend.composio.dev/api/v3";
+async function call(env: ComposioGmailEnv, path: string, body?: unknown): Promise<any> {
+  if (!env.COMPOSIO_API_KEY) throw new Error("Composio is not configured on this deployment.");
+  const response = await fetch(base + path, {
+    method: body === undefined ? "GET" : "POST",
+    headers: { "x-api-key": env.COMPOSIO_API_KEY, "Content-Type": "application/json" },
+    ...(body === undefined ? {} : { body: JSON.stringify(body) }),
+  });
+  const result: any = await response.json();
+  if (!response.ok || result.error || result.successful === false) {
+    throw new Error(String(result.error?.message ?? result.error ?? result.message ?? "Composio Gmail request failed"));
+  }
+  return result;
+}
+export async function gmailAccounts(env: ComposioGmailEnv, userId: string) {
+  const result = await call(env, `/connected_accounts?user_ids=${encodeURIComponent(userId)}&toolkit_slugs=gmail&statuses=ACTIVE&limit=200`);
+  if (!Array.isArray(result.items)) throw new Error("Composio returned an invalid account list.");
+  return result.items.filter((account: any) =>
+    String(account.status).toUpperCase() === "ACTIVE" &&
+    String(account.toolkit?.slug ?? account.appName ?? "").toLowerCase() === "gmail" &&
+    (!account.user_id || account.user_id === userId),
+  ).map((account: any) => ({ id: String(account.id), _id: String(account.id), provider: "gmail", is_active: true, display_name: String(account.data?.email ?? account.id), source: "composio" }));
+}
+export async function composioGmailSender(env: ComposioGmailEnv, userId: string) {
+  const accounts = await gmailAccounts(env, userId);
+  if (!accounts.length) throw new Error("Connect Gmail in Integrations before sending email.");
+  const accountId = accounts[0].id;
+  return async (recipientEmail: string, subject: string, body: string) => {
+    const result = await call(env, "/tools/execute/GMAIL_SEND_EMAIL", {
+      user_id: userId, connected_account_id: accountId,
+      arguments: { user_id: "me", recipient_email: recipientEmail, subject, body, is_html: false },
+    });
+    const providerMessageId = result.data?.id ?? result.data?.message_id;
+    if (result.successful !== true || !providerMessageId) throw new Error("Composio did not confirm delivery. Check the provider logs before retrying.");
+    return { providerMessageId: String(providerMessageId), raw: result };
+  };
+}
